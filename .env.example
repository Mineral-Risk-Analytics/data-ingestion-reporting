# Database
# Pooler URL — used by FastAPI at runtime
DATABASE_URL=postgresql+psycopg://bdi:bdi@localhost:5432/battery_intel
# Direct URL — used by Alembic for migrations (omit locally, only needed for Neon/PgBouncer)
DATABASE_URL_DIRECT=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Local raw storage root (relative to cwd or absolute)
STORAGE_ROOT=./storage

# Federal Register (Phase 1) — public API, no key required
FEDERAL_REGISTER_BASE_URL=https://www.federalregister.gov/api/v1
FEDERAL_REGISTER_USER_AGENT=battery-intel-ingestion/0.1 (research; contact@example.com)

# U.S. Census International Trade API (Phase 1)
# Request a key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
CENSUS_TRADE_BASE_URL=https://api.census.gov/data/timeseries/intltrade

# SEC EDGAR (Phase 1) — identify your client per SEC fair access policy
SEC_EDGAR_BASE_URL=https://data.sec.gov
SEC_EDGAR_USER_AGENT=battery-intel-ingestion contact@example.com

# News stub provider (Phase 1) — placeholder for future NewsAPI etc.
NEWS_PROVIDER=stub
NEWS_API_KEY=

# Future: OpenAI / other LLM (AI service placeholders)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
